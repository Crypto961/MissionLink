{
  "manifest_version": 3,
  "name": "IDR Bundle Filler (Demo)",
  "short_name": "IDR Filler",
  "version": "0.1.0",
  "description": "Fills the current IDR form page from a prepared bundle. The operator checks every field and submits; the extension never submits.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open IDR Bundle Filler"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*"]
}
